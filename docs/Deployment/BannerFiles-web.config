<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cache policy for job branding images (banner background/overlay, logo header).

  WHY: uploads reuse the same filename ({jobId}_{conventionName}.{ext}), so a
  re-upload changes the bytes behind an unchanged URL. With no Cache-Control,
  browsers apply heuristic freshness (~10% of the file's age) and can show a
  stale banner for weeks after a mid-season re-upload.

  DisableCache sends "Cache-Control: no-cache" = "revalidate before use", NOT
  "don't cache". IIS emits ETag/Last-Modified, so every view is a cheap 304
  until the file actually changes, then a 200 with the new bytes.

  DEPLOY (one-time hand drop, both statics boxes; IIS picks it up on file
  change, no restart):
    - This box:      C:\Websites\TSIC-STATICS\BannerFiles\web.config
    - TSIC-PHOENIX:  E:\Websites\TSIC-STATICS\BannerFiles\web.config

  Scoped to the BannerFiles folder only; the rest of the statics site keeps
  its existing cache behavior.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
