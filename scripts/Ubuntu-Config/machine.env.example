# Per-machine settings for a TSIC Ubuntu server. Copy to a location outside the
# repository (for example ~/.config/tsic/machine.env or /etc/tsic/machine.env) and
# fill in. Topology only: no passwords or keys belong in this file. Secrets go in
# the per-environment file described in secrets.env.example.
#
# The Windows equivalent is scripts/IIS-Config-{Dev,Prod}/_config.ps1.
#
# Three websites per environment, as under IIS: the app (Angular), the API, and
# Statics (shared by every environment on the machine).

# --- Accounts ---------------------------------------------------------------
# Account the API service runs as. Created by setup/install-server.sh.
SERVICE_USER=tsic
# Account that publishes builds (owns /opt/tsic, may restart the service).
DEPLOY_USER=todd
# Optional: an extra account allowed to write to the Statics folder. Only for a
# development machine, where the API also runs under F5 as a person. Leave empty
# on a server.
STATICS_EXTRA_WRITER=

# --- Firewall ----------------------------------------------------------------
# If ufw is active, install-server.sh opens the ports the sites listen on. Empty =
# open to anyone (a public server). Set an address or network to limit who may
# connect (a lab machine reached only through another one).
FIREWALL_ALLOW_FROM=

# --- Environments on this machine --------------------------------------------
# Space-separated. Each gets a service tsic-api@<name>, a folder /opt/tsic/<name>,
# a secrets file /etc/tsic/<name>.env and nginx sites tsic-app-<name> and
# tsic-api-<name>.
#   dev machine : staging          production machine : production
APP_ENVIRONMENTS="staging"

# --- TSIC-STATICS website ---------------------------------------------------
# Folder nginx serves. Owner: SERVICE_USER. Group: www-data.
STATICS_ROOT=/srv/tsic/statics
# Address and port nginx listens on, in nginx "listen" form.
#   lab/dev : 127.0.0.1:8082      real server : 80  (443 added with the certificate)
STATICS_LISTEN=127.0.0.1:8082
# Host name the site answers to. "_" matches any name (lab use).
STATICS_SERVER_NAME=statics.example.com
# Address browsers use for Statics (no trailing slash). Written into the web app's
# app-config.json at publish time.
STATICS_PUBLIC_URL=https://statics.example.com

# --- App and API sites, one block per environment ------------------------------
# The suffix is the environment name in upper case.

# App site: address and port nginx listens on (always TLS), and its host name.
APP_LISTEN_STAGING=127.0.0.1:8443
APP_SERVER_NAME_STAGING=dev.example.com
# API site: the same two.
API_LISTEN_STAGING=127.0.0.1:8444
API_SERVER_NAME_STAGING=devapi.example.com
# Addresses browsers use (no trailing slash). The API one is written into the web
# app's app-config.json at publish time. The app one must be allowed by the API:
# see Cors__AllowedOrigins in secrets.env.example.
APP_PUBLIC_URL_STAGING=https://dev.example.com
API_PUBLIC_URL_STAGING=https://devapi.example.com
# Loopback port the API (Kestrel) listens on. Must match ASPNETCORE_URLS in the
# environment's secrets file.
API_PORT_STAGING=5100
# TLS certificate and key, used by both the app site and the API site. Lab:
# self-signed, generated by install-server.sh when the files are missing. Real
# server: the Let's Encrypt paths.
TLS_CERT_STAGING=/etc/tsic/tls/staging.crt
TLS_KEY_STAGING=/etc/tsic/tls/staging.key
# Angular build configuration published to this environment.
NG_CONFIG_STAGING=staging-ubuntu
# Optional: publish to another machine over SSH (user@host). Empty = this machine.
DEPLOY_TARGET_STAGING=
