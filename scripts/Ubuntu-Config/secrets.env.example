# Settings and secrets for ONE environment's API service. The real file is
# /etc/tsic/<environment>.env, owner root, group = service account, mode 640.
# Never commit a filled-in copy.
#
# This file is the Ubuntu equivalent of the IIS app pool's environmentVariables
# collection (IIS-Config-{Dev,Prod}/Setup/07-Apply-Secrets.ps1 and 08-Set-AspNetEnv.ps1).
# systemd reads it: one NAME=value per line, no "export", values in double quotes.
# A double underscore in a name is a colon in appsettings: A__B is "A": { "B": ... }.

# --- Required: the app refuses to start without it ---------------------------
ASPNETCORE_ENVIRONMENT="Staging"

# --- Hosting behind nginx ----------------------------------------------------
# Loopback only; nginx is the only thing that talks to it.
ASPNETCORE_URLS="http://127.0.0.1:5100"
# Trust nginx's X-Forwarded-For / X-Forwarded-Proto so the app sees the real
# client address and that the request arrived over HTTPS.
ASPNETCORE_FORWARDEDHEADERS_ENABLED="true"

# --- Secrets -----------------------------------------------------------------
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=TSICV5;User Id=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true"
ConnectionStrings__LogsConnection="Server=localhost,1433;Database=TSICLogs;User Id=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true"
JwtSettings__SecretKey="CHANGE_ME"

# --- Addresses and paths for this machine ------------------------------------
FrontendSettings__BaseUrl="https://dev.example.com"
# The app site is a different site from the API, so the API must allow it by name
# (APP_PUBLIC_URL in machine.env). Index 20 adds to the list in appsettings instead
# of replacing an entry.
Cors__AllowedOrigins__20="https://dev.example.com"
TsicSettings__StaticsBaseUrl="https://statics.example.com"
TSIC_BASEURL_STATICS="https://statics.example.com/"
FileStorage__BannerFilesPath="/srv/tsic/statics/BannerFiles"
FileStorage__MedFormsPath="/srv/tsic/statics/RegFileUploads/MedForms"
FileStorage__HeadshotsPath="/srv/tsic/statics/Headshots-AllRegistrants"
FileStorage__StoreImagesPath="/srv/tsic/statics/Store-Sku-Images"
FileStorage__MonthEndExportPath="/var/lib/tsic/staging/AdnMonthEnd"
Seq__ServerUrl="http://localhost:5341"

# --- Email -------------------------------------------------------------------
AWS__Region="us-east-1"
EmailSettings__EmailingEnabled="false"
