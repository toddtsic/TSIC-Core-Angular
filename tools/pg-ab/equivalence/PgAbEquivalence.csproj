<Project Sdk="Microsoft.NET.Sdk">

  <!-- Postgres port A/B check: runs the repository methods the port rewrote against SQL Server and
       Postgres and compares the results. Branch feature/postgres-port only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PgAbEquivalence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TSIC-Core-Angular\src\backend\TSIC.Infrastructure\TSIC.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
  </ItemGroup>

</Project>
