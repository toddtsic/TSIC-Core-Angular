<?xml version="1.0" encoding="UTF-8"?>
<!--
  Folder-scoped config for /.well-known/ ONLY. Deliberately NOT merged into the site-level
  web.config (scripts/web.config.angular): that file carries HSTS, the SPA rewrite, the
  httpErrors 404 handler and the 1-year cache policy, and a malformed edit there is a 500.19
  across the whole site. Scoped here, the worst case is a 500.19 on /.well-known/* alone.

  mimeMap ".": apple-app-site-association has NO file extension, and IIS refuses to serve a
  file it has no MIME mapping for. Without this line it 404s -> which the site-level
  httpErrors rule turns into "200 OK with index.html", so it looks served and is not.

  DisableCache: the site default is cacheControlMaxAge 365 days. These files change when a
  signing certificate or claimed domain changes; a browser or OS holding a year-old copy
  would never learn of it.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension="." mimeType="application/json" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
