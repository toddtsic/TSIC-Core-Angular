{
    "ConnectionStrings": {
        "DefaultConnection": "Server=.\\SS2016;Database=TSICV5;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
        "LogsConnection": "Server=.\\SS2016;Database=TSICLogs;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "Usage": {
        "// LingerSeconds": "Short on dev so a logged request lands while the tester is still looking at it. Trade: batches of one never exercise the multi-row enrichment path -- fire a burst to test that.",
        "LingerSeconds": 2
    },
    "JwtSettings": {
        "Issuer": "TSIC.API",
        "Audience": "TSIC.Client",
        "ExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 7
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft.EntityFrameworkCore.Database.Command": "Information"
            }
        }
    },
    "Reporting": {
        "CrystalReportsBaseUrl": "https://tsic-cr-2025.conveyor.cloud/api/"
    },
    "// FileStorage": "Same on every machine that F5s this repo: dev statics, never prod's. C:\\Websites\\TSIC-STATICS is reserved for the DR mirror of PHOENIX's statics.",
    "FileStorage": {
        "BannerFilesPath": "C:\\Websites\\TSIC-STATICS-DEV\\BannerFiles",
        "MedFormsPath": "C:\\Websites\\TSIC-STATICS-DEV\\RegFileUploads\\MedForms",
        "HeadshotsPath": "C:\\Websites\\TSIC-STATICS-DEV\\Headshots-AllRegistrants",
        "StoreImagesPath": "C:\\Websites\\TSIC-STATICS-DEV\\Store-Sku-Images"
    },
    "TsicSettings": {
        "StaticsBaseUrl": "https://devstatics.teamsportsinfo.com"
    },
    "FrontendSettings": {
        "BaseUrl": "http://localhost:4200"
    },
    "Cors": {
        "AllowedOrigins": [
            "https://localhost:4200",
            "https://*.teamsportsinfo.com",
            "https://teamsportsinfo.com",
            "https://localhost:4205",
            "https://localhost:4206",
            "capacitor://localhost",
            "https://localhost",
            "http://10.0.0.123:8100"
        ]
    },
    "bGoLive": true,
    "AllowedHosts": "*"
}
