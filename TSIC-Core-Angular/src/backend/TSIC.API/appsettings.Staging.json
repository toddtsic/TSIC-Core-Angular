{
    "ConnectionStrings": {
        "DefaultConnection": "Server=.\\SS2016;Database=TSICV5;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
        "LogsConnection": "Server=.\\SS2016;Database=TSICLogs;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "Usage": {
        "// LingerSeconds": "Staging is where a deploy gets verified, so it runs short too -- but not as short as dev, since this box carries real client-facing traffic and should still batch.",
        "LingerSeconds": 5
    },
    "FrontendSettings": {
        "BaseUrl": "https://dev.teamsportsinfo.com"
    },
    "// FileStorage": "Staging's OWN statics (devstatics), never prod's. C:\\Websites\\TSIC-STATICS on this box is reserved for the DR mirror of PHOENIX's statics. MonthEndExportPath stays from appsettings.json.",
    "FileStorage": {
        "BannerFilesPath": "C:\\Websites\\TSIC-STATICS-DEV\\BannerFiles",
        "MedFormsPath": "C:\\Websites\\TSIC-STATICS-DEV\\RegFileUploads\\MedForms",
        "HeadshotsPath": "C:\\Websites\\TSIC-STATICS-DEV\\Headshots-AllRegistrants",
        "StoreImagesPath": "C:\\Websites\\TSIC-STATICS-DEV\\Store-Sku-Images"
    },
    "// TsicSettings": "StaticsBaseUrl is the ONLY statics address setting: every link the API builds (incl. bulletin/email tokens via TsicConstants.BaseUrlStatics) reads it.",
    "TsicSettings": {
        "StaticsBaseUrl": "https://devstatics.teamsportsinfo.com"
    },
    "Cors": {
        "AllowedOrigins": [
            "https://localhost:4200",
            "https://*.teamsportsinfo.com",
            "https://teamsportsinfo.com",
            "https://localhost:4205",
            "https://localhost:4206",
            "capacitor://localhost",
            "https://localhost",
            "http://10.0.0.123:8100"
        ]
    },
    "AdnSweep": {
